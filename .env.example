# ── App ──
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Firma de cookies de cliente y equipo. Genera uno con: openssl rand -hex 32
SESSION_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
# Protege /api/cron/*. Vercel Cron lo envía como "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=cambia-esto-por-otro-secreto

# ── Supabase (pnpm db:start imprime los valores locales) ──
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Mensajería: mock (por defecto, no envía nada) | whatsapp ──
MESSAGING_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── IA para redactar mensajes: template (por defecto) | claude ──
AI_PROVIDER=template
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Tarjetas en Wallet (opcional). Guía: docs/WALLET.md. Los PEM y el JSON van en base64 (una sola línea) ──
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_CERT_PEM=
APPLE_WALLET_KEY_PEM=
APPLE_WALLET_KEY_PASSPHRASE=
APPLE_WALLET_WWDR_PEM=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT=

# ── Notificaciones por Web Push (opcional). Genera las claves con: npx web-push generate-vapid-keys ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo-real@ejemplo.com
